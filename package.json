{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck && tsc --noEmit -p infra",
    "recipes": "node scripts/build-recipes.mjs",
    "mods": "node scripts/build-mods.mjs",
    "deploy": "nuxt generate && node scripts/deploy.mjs full",
    "diff": "cdk diff",
    "deploy:web": "nuxt generate && node scripts/deploy.mjs web",
    "destroy": "node scripts/deploy.mjs destroy"
  },
  "dependencies": {
    "nuxt": "^4.6.2",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@nuxt/eslint": "^1.17.0",
    "@nuxtjs/robots": "^6.2.4",
    "@nuxtjs/sitemap": "^8.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "aws-cdk": "^2.1146.1",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1",
    "eslint": "^10.12.0",
    "fflate": "^0.8.3",
    "nuxt-link-checker": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.13",
    "zod": "^4.6.6"
  },
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610"
}
